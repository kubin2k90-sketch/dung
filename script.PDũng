local function SetupESP(player)
    if player == LocalPlayer then return end
    local esp = {
        Box = Drawing.new("Square"),
        HealthBar = Drawing.new("Square"),
        HealthFill = Drawing.new("Square"),
        Tracer = Drawing.new("Line")
    }
    esp.Box.Thickness = 1.5; esp.Box.Filled = false; esp.Box.Color = Color3.fromRGB(255, 255, 255)
    esp.HealthBar.Thickness = 1; esp.HealthBar.Filled = true; esp.HealthBar.Color = Color3.fromRGB(0, 0, 0)
    esp.HealthFill.Thickness = 1; esp.HealthFill.Filled = true
    esp.Tracer.Thickness = 1; esp.Tracer.Color = Color3.fromRGB(255, 255, 255)
    
    for _, obj in pairs(esp) do obj.Visible = false end
    ESPList[player] = esp
end

for _, p in pairs(Players:GetPlayers()) do SetupESP(p) end
Players.PlayerAdded:Connect(SetupESP)
Players.PlayerRemoving:Connect(function(p)
    if ESPList[p] then
        for _, obj in pairs(ESPList[p]) do obj:Remove() end
        ESPList[p] = nil
    end
end)

local lastFPS = 0
RunService.RenderStepped:Connect(function(dt)
    if Settings.ShowFPS then
        lastFPS = lastFPS + dt
        if lastFPS >= 0.5 then
            FPSText.Text = "FPS: " .. math.floor(1 / dt)
            lastFPS = 0
        end
    end

    if Settings.HitboxEnabled then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local realPlayer = Players:GetPlayerFromCharacter(p.Character)
                if realPlayer then
                    local part = p.Character:FindFirstChild(Settings.TargetPart) or p.Character:FindFirstChild("Torso")
                    if part then
                        if not OriginalSizes[part] then OriginalSizes[part] = part.Size end
                        part.Size = Vector3.new(Settings.HitboxSize, Settings.HitboxSize, Settings.HitboxSize)
                        part.Transparency = 0.5
                        part.CanCollide = false
                        part.Massless = true
                    end
                end
            end
        end
    end

    for p, esp in pairs(ESPList) do
        local char = p.Character
        local realPlayer = char and Players:GetPlayerFromCharacter(char)
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        local active = Settings.ESPEnabled and realPlayer and humanoid and humanoid.Health > 0
        local rootPart = active and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
        
        if rootPart then
            local dist = (rootPart.Position - Camera.CFrame.Position).Magnitude
            if dist <= Settings.ESPDistanceMax then
                local screenPos, _ = Camera:WorldToViewportPoint(rootPart.Position)
                
                if screenPos.Z > 0 then
                    local cf = char:GetPivot()
                    local topPos, topVis = Camera:WorldToViewportPoint((cf + Vector3.new(0, 2.8, 0)).Position)
                    local botPos, botVis = Camera:WorldToViewportPoint((cf - Vector3.new(0, 2.5, 0)).Position)
                    
                    if topVis and botVis then
                        local h = math.abs(topPos.Y - botPos.Y)
                        local w = h / 2
                        local topLeft = Vector2.new(topPos.X - w / 2, topPos.Y)

                        if Settings.ESPBox then
                            esp.Box.Size = Vector2.new(w, h)
                            esp.Box.Position = topLeft
                            esp.Box.Visible = true
                        else
                            esp.Box.Visible = false
                        end

                        if Settings.ESPHealth then
                            local hp = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                            esp.HealthBar.Size = Vector2.new(4, h)
                            esp.HealthBar.Position = Vector2.new(topLeft.X - 6, topLeft.Y)
                            esp.HealthBar.Visible = true

                            esp.HealthFill.Size = Vector2.new(2, h * hp)
                            esp.HealthFill.Position = Vector2.new(topLeft.X - 5, topLeft.Y + (h * (1 - hp)))
                            esp.HealthFill.Color = Color3.fromHSV(hp * 0.3, 1, 1)
                            esp.HealthFill.Visible = true
                        else
                            esp.HealthBar.Visible = false
                            esp.HealthFill.Visible = false
                        end

                        if Settings.ESPTracer then
                            esp.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                            esp.Tracer.To = Vector2.new(topPos.X, topPos.Y + h)
                            esp.Tracer.Visible = true
                        else
                            esp.Tracer.Visible = false
                        end
                    else
                        for _, obj in pairs(esp) do obj.Visible = false end
                    end
                else
                    for _, obj in pairs(esp) do obj.Visible = false end
                end
            else
                for _, obj in pairs(esp) do obj.Visible = false end
            end
        else
            for _, obj in pairs(esp) do obj.Visible = false end
        end
    end
end)
